# Mot de passe(s) admin, créés au démarrage du serveur
USER_JSON=[{"user":"admin","password":"ton_mot_de_passe"}]
# Clé qui signe les jetons ADMIN (login)
JWT_TOKEN_KEY=un_token_secret_long_et_complexe
# Clé qui signe les jetons VISITEUR (sync). DOIT être différente de JWT_TOKEN_KEY.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
VISITOR_TOKEN_KEY=une_autre_cle_longue_et_differente
DB_PASSWORD=ton_vrai_mot_de_passe_mysql
# Token du Raspberry Pi (route /api/raspberry/ping)
AUTHORIZED_TOKEN=un_token_utilise_pour_ton_api_interne
# Bot Discord
TOKEN_DISCORD=xyz.abc.123
